<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>

    <!-- WebDAV tamamen devre dışı -->
    <modules>
      <remove name="WebDAVModule" />
    </modules>

    <!-- Dizin listeleme kapalı -->
    <directoryBrowse enabled="false" />

    <!-- Varsayılan belge -->
    <defaultDocument>
      <files>
        <clear />
        <add value="index.php" />
      </files>
    </defaultDocument>

    <!-- PHP handler -->
    <handlers>
            <remove name="PHP_via_FastCGI" />
      <remove name="PHP" />
      <add name="PHP_FastCGI_iaa" path="*.php" verb="*" modules="FastCgiModule" scriptProcessor="C:\tools\php829\php-cgi.exe" resourceType="File" requireAccess="Script" />
            <add name="PHP_via_FastCGI" path="*.php" verb="*" modules="FastCgiModule" scriptProcessor="C:\tools\php829\php-cgi.exe" resourceType="File" requireAccess="Script" />
    </handlers>

    <!-- URL Rewrite -->
    <rewrite>
      <rules>
        <clear />

        <!-- public/storage erişimi -->
        <rule name="Storage Direct Access" stopProcessing="true">
          <match url="^storage/(.*)$" />
          <action type="Rewrite" url="storage/{R:1}" />
        </rule>

        <!-- Livewire varlıkları -->
        <rule name="Vendor Livewire Assets" stopProcessing="true">
          <match url="^vendor/livewire/(.*)$" />
          <action type="Rewrite" url="vendor/livewire/{R:1}" />
        </rule>

        <!-- Laravel & Livewire route'ları -->
        <rule name="Laravel Routes" stopProcessing="true">
  <conditions>
    <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
    <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
  </conditions>
  <match url="^(.*)$" ignoreCase="false" />
  <!-- ÖNEMLİ: PATH_INFO (index.php/{R:1}) yerine QUERY STRING kullan -->
  <action type="Rewrite" url="/iaa/index.php?{R:1}" appendQueryString="true" />
</rule>

      </rules>
    </rewrite>

  </system.webServer>
</configuration>
